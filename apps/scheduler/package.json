{
  "name": "scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Local EventBridge-compatible scheduler service",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/scheduler/persistence && cp src/scheduler/persistence/schema.sql dist/scheduler/persistence/schema.sql",
    "start": "node dist/main.js",
    "start:cli": "node dist/cli.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules RUN_SCHEDULER_INTEGRATION=true jest src/scheduler/integration/elasticmq.integration.spec.ts --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@raffleroyale/queue-signature": "0.1.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "dotenv": "^16.6.1",
    "nest-commander": "^3.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
