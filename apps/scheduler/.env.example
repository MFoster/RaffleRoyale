# Scheduler service configuration

# SQLite database file path (will be created if it doesn't exist)
SCHEDULER_DB_PATH=/app/data/scheduler.db

# SQS queue URL for scheduling delivery (EventBridge events go here)
SCHEDULER_SQS_TARGET_QUEUE_URL=http://elasticmq:9324/queue/raffle-events

# ElasticMQ SQS endpoint (local development only)
SCHEDULER_SQS_ENDPOINT_URL=http://elasticmq:9324

# Background worker poll interval in milliseconds
SCHEDULER_POLL_INTERVAL_MS=1000

# Set to false when running CLI-only workflows
SCHEDULER_WORKER_ENABLED=true

# HTTP server port
PORT=3002

# AWS SDK configuration (dummy values for local ElasticMQ)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x
