# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raffle_royale?schema=public"

# API runtime
PORT=3001
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="dev-jwt-secret-change-me"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
RAFFLE_EXPIRATION_CRON_ENABLED="true"
RAFFLE_IMAGE_UPLOAD_CLEANUP_ENABLED="true"

# drand randomness beacon used for verifiable raffle winner draws (commit-reveal).
# Defaults target the public drand "quicknet" network. In egress-restricted dev
# environments these point at the local signed mock beacon (see docker-compose.dev.yml).
# DRAND_BASE_URL="https://api.drand.sh"
# DRAND_CHAIN_HASH="52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971"
# Seconds in the future to pin the committed beacon round before it is revealed.
# DRAND_DRAW_LEAD_SECONDS="30"
