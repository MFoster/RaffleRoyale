generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  PHYSICAL
  DIGITAL
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  EXPIRED
  PENDING_DRAW
  DISBANDED
  COMPLETED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
}

enum RaffleEventType {
  CREATED
  TICKET_PURCHASED
  SOLD_OUT
  EXPIRED
  DRAW_COMMITTED
  WINNER_SELECTED
  DISBANDED
  PAYOUT_SENT
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  phone       String?
  displayName String?       @map("display_name")
  bio         String?
  passwordHash String       @map("password_hash")
  kycStatus   KycStatus     @default(PENDING) @map("kyc_status")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  raffles      Raffle[]
  tickets      Ticket[]
  transactions Transaction[]
  payouts      Payout[]
  pendingRaffleImageUploads PendingRaffleImageUpload[]

  @@map("users")
}

model Raffle {
  id             String         @id @default(uuid())
  rafflerId      String         @map("raffler_id")
  title          String
  description    String?
  imageUrls      String[]       @default([]) @map("image_urls")
  itemType       ItemType       @default(PHYSICAL) @map("item_type")
  totalTickets   Int            @map("total_tickets")
  ticketPrice    Int            @map("ticket_price")
  ticketsSold    Int            @default(0) @map("tickets_sold")
  minSellThrough Int?           @map("min_sell_through")
  status         RaffleStatus   @default(DRAFT)
  startTime      DateTime       @default(now()) @map("start_time")
  endTime        DateTime       @map("end_time")
  drawBeaconRound     BigInt?    @map("draw_beacon_round")
  drawBeaconChainHash String?    @map("draw_beacon_chain_hash")
  drawScheme          String?    @map("draw_scheme")
  drawCommittedAt     DateTime?  @map("draw_committed_at")
  drawAvailableAt     DateTime?  @map("draw_available_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  raffler      User           @relation(fields: [rafflerId], references: [id])
  tickets      Ticket[]
  transactions Transaction[]
  payouts      Payout[]
  events       RaffleEvent[]
  pendingImageUploads PendingRaffleImageUpload[]

  @@index([status, endTime])
  @@index([status, drawAvailableAt])
  @@index([rafflerId])
  @@map("raffles")
}

model PendingRaffleImageUpload {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  raffleId  String?  @map("raffle_id")
  fileName  String   @unique @map("file_name")
  mimeType  String   @map("mime_type")
  urlPath   String   @map("url_path")
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")

  owner  User   @relation(fields: [ownerId], references: [id])
  raffle Raffle? @relation(fields: [raffleId], references: [id])

  @@index([ownerId, consumedAt, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("pending_raffle_image_uploads")
}

model Ticket {
  id            String   @id @default(uuid())
  raffleId      String   @map("raffle_id")
  buyerId       String   @map("buyer_id")
  ticketNumber  Int      @map("ticket_number")
  transactionId String   @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  raffle      Raffle      @relation(fields: [raffleId], references: [id])
  buyer       User        @relation(fields: [buyerId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])
  winnerEvents RaffleEvent[] @relation("WinnerTicketEvents")

  @@unique([raffleId, ticketNumber])
  @@index([buyerId])
  @@index([raffleId])
  @@map("tickets")
}

model Transaction {
  id                   String            @id @default(uuid())
  userId               String            @map("user_id")
  raffleId             String            @map("raffle_id")
  amount               Int
  currency             String            @default("usd")
  stripePaymentIntentId String?          @map("stripe_payment_intent_id")
  status               TransactionStatus @default(PENDING)
  createdAt            DateTime          @default(now()) @map("created_at")

  user   User     @relation(fields: [userId], references: [id])
  raffle Raffle   @relation(fields: [raffleId], references: [id])
  tickets Ticket[]

  @@index([userId])
  @@map("transactions")
}

model Payout {
  id               String       @id @default(uuid())
  raffleId         String       @map("raffle_id")
  rafflerId        String       @map("raffler_id")
  amount           Int
  stripeTransferId String?      @map("stripe_transfer_id")
  status           PayoutStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at")

  raffle  Raffle @relation(fields: [raffleId], references: [id])
  raffler User   @relation(fields: [rafflerId], references: [id])

  @@map("payouts")
}

model RaffleEvent {
  id             String          @id @default(uuid())
  raffleId       String          @map("raffle_id")
  eventType      RaffleEventType @map("event_type")
  winnerTicketId String?         @map("winner_ticket_id")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  raffle       Raffle @relation(fields: [raffleId], references: [id])
  winnerTicket Ticket? @relation("WinnerTicketEvents", fields: [winnerTicketId], references: [id])

  @@index([raffleId])
  @@index([winnerTicketId])
  @@map("raffle_events")
}
