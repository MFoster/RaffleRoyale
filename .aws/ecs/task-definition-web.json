{
  "family": "raffle-royale-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/RaffleRoyaleEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "REPLACE_WEB_IMAGE",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "NEXT_SERVER_ORIGIN", "value": "http://127.0.0.1:3000" },
        { "name": "API_PROXY_TARGET", "value": "__WEB_API_PROXY_TARGET__" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/raffle-royale-web",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
