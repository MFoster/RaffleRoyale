{
  "family": "raffle-royale-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/RaffleRoyaleEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "REPLACE_API_IMAGE",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3001" },
        { "name": "DATABASE_URL", "value": "__DATABASE_URL__" },
        { "name": "FRONTEND_URL", "value": "__FRONTEND_URL__" },
        { "name": "JWT_SECRET", "value": "__JWT_SECRET__" },
        { "name": "JWT_REFRESH_SECRET", "value": "__JWT_REFRESH_SECRET__" },
        { "name": "JWT_ACCESS_EXPIRES_IN", "value": "15m" },
        { "name": "JWT_REFRESH_EXPIRES_IN", "value": "7d" },
        { "name": "RAFFLE_EXPIRATION_CRON_ENABLED", "value": "true" },
        { "name": "RAFFLE_IMAGE_UPLOAD_CLEANUP_ENABLED", "value": "true" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "api-uploads",
          "containerPath": "/workspace/apps/api/uploads",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/raffle-royale-api",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "api-uploads",
      "efsVolumeConfiguration": {
        "fileSystemId": "__ECS_API_UPLOADS_EFS_FILESYSTEM_ID__",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "__ECS_API_UPLOADS_EFS_ACCESS_POINT_ID__",
          "iam": "DISABLED"
        }
      }
    }
  ]
}
