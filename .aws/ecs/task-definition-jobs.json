{
  "family": "raffle-royale-jobs",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/RaffleRoyaleEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "jobs",
      "image": "REPLACE_JOBS_IMAGE",
      "essential": true,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "JOBS_SQS_QUEUE_URL", "value": "__JOBS_SQS_QUEUE_URL__" },
        { "name": "JOBS_SQS_REPLY_QUEUE_URL", "value": "__JOBS_SQS_REPLY_QUEUE_URL__" }
      ],
      "stopTimeout": 120,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/raffle-royale-jobs",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
