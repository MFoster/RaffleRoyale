{
  "name": "raffle-royale",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w web\" \"npm run start:dev -w api\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "dev:jobs": "npm run dev -w jobs",
    "jobs": "npm run dev -w jobs --",
    "jobs:seed": "npm run jobs -- seed",
    "prisma:generate": "npm run prisma:generate -w @raffleroyale/db",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w @raffleroyale/db",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w @raffleroyale/db",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
